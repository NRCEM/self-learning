# Copy this file to .env.local and fill in your own key. Never commit .env.local.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Server-only model; must support PDF input and structured JSON output.
GEMINI_MODEL=gemini-3.5-flash-lite
# Backend only. Enable YouTube Data API v3 in the key's Google Cloud project.
YOUTUBE_API_KEY=
# On Vercel, set these same variables for Production and any Preview deployments.
# Changes require a new deployment; never use NEXT_PUBLIC_ for API keys.
